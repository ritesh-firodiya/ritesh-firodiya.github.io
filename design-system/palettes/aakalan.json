{
  "name": "aakalan",
  "product": "Aakalan",
  "surfaces": ["mobile"],
  "_": [
    "Reference implementation of the two-theme rule. aakalan was the only set",
    "in the tree with a complete dark palette — every token has a dark value,",
    "including all seven category pairs and all four status trios.",
    "",
    "Renames applied: indigo-* -> brand-*, saffron-* -> accent-*,",
    "--text-primary -> --ink, --border -> --line, --page-bg -> --page.",
    "Values are unchanged; a retoken here must be invisible on screen."
  ],
  "shadowTint": "22 24 43",
  "themes": {
    "light": {
      "brand-50": "#eef0fe", "brand-100": "#dcdffd", "brand-200": "#b8befa",
      "brand-400": "#7d80e8", "brand-500": "#5b5bd6", "brand-700": "#3a37a8",
      "brand-900": "#211f5c",

      "accent-50": "#fff7e8", "accent-100": "#ffecc7", "accent-200": "#ffd98d",
      "accent-400": "#fbbf4a", "accent-500": "#f5a524", "accent-600": "#d98410",
      "accent-700": "#a3620b",

      "ink": "#16182b", "ink-2": "#565a75", "ink-3": "#878ba6",
      "ink-4": "#b6b9cc", "ink-inverse": "#ffffff",

      "page": "#f4f5f9", "frame": "#ffffff", "surface": "#ffffff",
      "muted": "#fafafd", "sunken": "#eeeff5",

      "line": "#e6e8f0", "line-strong": "#d3d6e4",

      "success": "#12a150", "success-bg": "#eafaf1", "success-fg": "#0c7a3d",
      "warn": "#f5a524", "warn-bg": "#fff7e8", "warn-fg": "#a3620b",
      "danger": "#e5484d", "danger-bg": "#ffefef", "danger-fg": "#c62a2f",
      "info": "#0091ff", "info-bg": "#e6f4ff", "info-fg": "#006adc"
    },
    "dark": {
      "brand-50": "#232566", "brand-100": "#2c2f7a", "brand-200": "#3b3f9e",
      "brand-400": "#9a9cf0", "brand-500": "#5b5bd6", "brand-700": "#b3b5ff",
      "brand-900": "#dcdcff",

      "accent-50": "#33260a", "accent-100": "#45340e", "accent-200": "#6b5116",
      "accent-400": "#fbbf4a", "accent-500": "#f5a524", "accent-600": "#ffc766",
      "accent-700": "#ffd98d",

      "ink": "#f4f5fb", "ink-2": "#b9bcd6", "ink-3": "#8f93b3",
      "ink-4": "#6a6e8e", "ink-inverse": "#16182b",

      "page": "#101223", "frame": "#101223", "surface": "#1c1e35",
      "muted": "#23253d", "sunken": "#262842",

      "line": "#2a2c48", "line-strong": "#3a3d5e",

      "success": "#3ddc84", "success-bg": "#10301f", "success-fg": "#3ddc84",
      "warn": "#f5a524", "warn-bg": "#33260a", "warn-fg": "#ffd98d",
      "danger": "#ff7b7e", "danger-bg": "#351a1d", "danger-fg": "#ff7b7e",
      "info": "#4db8ff", "info-bg": "#0d2438", "info-fg": "#7cc9ff"
    }
  },
  "shadowAlpha": { "dark": { "a1": "0.35", "a2": "0.45", "a3": "0.6" } },
  "reserved": {
    "_": [
      "Money direction is a different axis from success/danger: an expense can",
      "be settled correctly (success) and still be money you owe (neg). The two",
      "scales must not collapse into each other.",
      "",
      "settled and the two glow tokens were referenced by the design and never",
      "declared in src/global.css. Declaring them here is what fixes that."
    ],
    "pos": { "light": "#12a150", "dark": "#3ddc84" },
    "pos-bg": { "light": "#eafaf1", "dark": "#10301f" },
    "pos-fg": { "light": "#0c7a3d", "dark": "#3ddc84" },
    "neg": { "light": "#e5484d", "dark": "#ff7b7e" },
    "neg-bg": { "light": "#ffefef", "dark": "#351a1d" },
    "neg-fg": { "light": "#c62a2f", "dark": "#ff7b7e" },
    "settled": { "light": "#878ba6", "dark": "#8f93b3" },
    "pos-glow": { "light": "#3ddc84", "dark": "#3ddc84" },
    "neg-glow": { "light": "#ff7b7e", "dark": "#ff7b7e" },

    "cat-food": { "light": "#f97316", "dark": "#ff9448" },
    "cat-food-bg": { "light": "#fff2e6", "dark": "#3a2312" },
    "cat-travel": { "light": "#0091ff", "dark": "#4db8ff" },
    "cat-travel-bg": { "light": "#e6f4ff", "dark": "#0d2438" },
    "cat-stay": { "light": "#8b5cf6", "dark": "#a98bff" },
    "cat-stay-bg": { "light": "#f3eeff", "dark": "#291f45" },
    "cat-home": { "light": "#92400e", "dark": "#d99a5b" },
    "cat-home-bg": { "light": "#f7efe7", "dark": "#33230f" },
    "cat-fun": { "light": "#ec4899", "dark": "#ff6fb0" },
    "cat-fun-bg": { "light": "#ffeef7", "dark": "#3b1830" },
    "cat-shop": { "light": "#f5a524", "dark": "#ffc766" },
    "cat-shop-bg": { "light": "#fff7e8", "dark": "#33260a" },
    "cat-util": { "light": "#64748b", "dark": "#9aa6bd" },
    "cat-util-bg": { "light": "#eef1f5", "dark": "#232a36" }
  },
  "gradients": {
    "mark": "linear-gradient(140deg, var(--brand-400), var(--brand-700))",
    "group-mark": "linear-gradient(120deg, var(--info), var(--brand-400))"
  }
}
